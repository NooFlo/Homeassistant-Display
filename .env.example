# Home Assistant as seen from this container.
# If HA runs on another machine, use its LAN address, e.g. http://192.168.1.20:8123
HA_URL=http://homeassistant:8123

# Long-lived access token created in HA (user profile -> Security).
# The token is injected server-side; it never reaches the Kindle.
KINDLE_HA_TOKEN=replace-me

# Port the dashboard is served on (LAN, plain HTTP).
KINDLE_UI_PORT=8124
