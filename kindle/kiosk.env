# Kindle-side configuration for the HA display kiosk.
# Edit BEFORE running scripts/install-kindle.sh (it copies this file to
# /mnt/us/kiosk/kiosk.env on the device).

# LAN address and port of the kindle-ui nginx proxy.
SERVER_IP=192.168.1.10
SERVER_PORT=8124

# Touch input device (list with: ls /dev/input/ on the device).
TOUCH=/dev/input/event0

# Wake-capable RTC (PW1 exposes it as rtc1; check /sys/class/rtc/).
RTC=/sys/class/rtc/rtc1

# Seconds without touch before the device suspends.
IDLE=180

# While presence is active (input_boolean.kindle_wake = on) the device
# stays in light sleep and polls the wake boolean this often.
POLL=5

# After this many seconds of presence-active light sleep without touch,
# give up and deep sleep anyway (battery guard).
LIGHT_SLEEP_MAX=3600

# Deep-sleep RTC auto-wake interval (seconds).
ALARM=43200

# Push battery level into HA every N polls while awake.
BATT_EVERY=12

# HA entity that receives the battery level.
BATT_ENTITY=sensor.kindle_battery

# FBInk binary used by the native loop to paint /generated/dashboard.png.
# Install FBInk via KUAL (or place the binary and set the full path).
FBINK_BIN=fbink

# Native mode: full-mount path of the rendered dashboard the loop
# fetches (default matches server/nginx.conf.template).
# NATIVE_PATH=/generated/dashboard.png
